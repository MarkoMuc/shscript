#!/bin/bash
set -Eeuo pipefail

notify() {
  if command -v notify-send >/dev/null; then
    notify-send -u "$1" -t 5000 -a "Monitor switching" "$2" || true
  fi
}

die() {
  printf '%s\n' "$1" >&2
  notify critical "$1"
  exit 1
}

usage() {
  echo "Usage: ${0##*/} {pundr|plr|lpnly} [--dry-run]"
}

case "${1:-}" in
  pundr|plr|lpnly) layout=$1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac
dry_run=false
if [[ ${2:-} == --dry-run ]]; then dry_run=true; fi
if (( $# > 2 )) || { (( $# == 2 )) && ! $dry_run; }; then
  usage >&2
  exit 1
fi

for dependency in kscreenctl jq; do
  command -v "$dependency" >/dev/null || die "$dependency not found"
done
trap 'die "Monitor switching failed; the layout may be partially applied. See terminal output."' ERR

outputs=$(kscreenctl list-outputs --json | jq -er '
  [.[] | select(.connected) |
    . as $output |
    (.modes | max_by(.resolution.width * .resolution.height, .refreshRate)) as $mode |
    if $mode == null then error("No modes for " + .name) else
      ($output.rotation | IN("90", "270", "flipped90", "flipped270")) as $rotated |
      {name, internal: (.name | test("^(eDP|LVDS|DSI)-")),
       mode: $mode.id, hz: $mode.refreshRate,
       width: (($mode.resolution | if $rotated then .height else .width end) / .scale | round),
       height: (($mode.resolution | if $rotated then .width else .height end) / .scale | round)}
    end]')

[[ $(jq '[.[] | select(.internal)] | length' <<< "$outputs") == 1 ]] ||
  die "Expected one internal display (eDP, LVDS or DSI)."
read -r panel panel_mode panel_width panel_height panel_hz < <(
  jq -r '.[] | select(.internal) | [.name, .mode, .width, .height, .hz] | @tsv' <<< "$outputs"
)
mapfile -t externals < <(jq -r '.[] | select(.internal | not) | .name' <<< "$outputs")
if [[ $layout != lpnly && ${#externals[@]} != 1 ]]; then
  die "This layout needs exactly one connected external display."
fi

run() {
  if $dry_run; then
    printf '%q ' kscreenctl "$@"; printf '\n'
  else
    kscreenctl "$@" >/dev/null
  fi
}

run "$panel" set-enabled true
run "$panel" set-mode "$panel_mode"

if [[ $layout == lpnly ]]; then
  for external in "${externals[@]}"; do
    run "$external" set-enabled false
  done
  run "$panel" set-primary
  run "$panel" set-position 0 0
  message="✅ 💻 Laptop only"
else
  read -r external external_mode external_width external_height external_hz < <(
    jq -r '.[] | select(.internal | not) | [.name, .mode, .width, .height, .hz] | @tsv' <<< "$outputs"
  )
  run "$external" set-enabled true
  run "$external" set-mode "$external_mode"
  run "$external" set-primary
  run "$panel" set-priority 2

  if [[ $layout == pundr ]]; then
    panel_x=$(( (external_width - panel_width) / 2 ))
    panel_y=$external_height
    message="✅ 📺 Monitor ↕️ 💻 Laptop"
  else
    panel_x=$external_width
    panel_y=$(( external_height - panel_height ))
    message="✅ 📺 Monitor ↔️ 💻 Laptop"
  fi
  external_x=$(( panel_x < 0 ? -panel_x : 0 ))
  external_y=$(( panel_y < 0 ? -panel_y : 0 ))
  run "$external" set-position "$external_x" "$external_y"
  run "$panel" set-position "$((panel_x + external_x))" "$((panel_y + external_y))"
fi

if ! $dry_run; then notify normal "$message"; fi
